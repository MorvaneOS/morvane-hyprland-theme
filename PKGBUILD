# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for Hyprland. Everything installed is generated by tools/build.py
# and committed, so building the package needs nothing but the repo.

pkgname=morvane-hyprland-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for Hyprland: border colours and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-hyprland-theme'
license=(LGPL-2.1-or-later)
depends=(
  hyprland            # the Lua config, 0.55 and later
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wm-theme    # kitty, dunst, wofi
  morvane-wallpapers
  swaybg
)

package() {
  install -Dm644 "$startdir"/theme/theme.lua -t "$pkgdir/usr/share/morvane-hyprland-theme/"
  # New users' ~/.config/hypr/hyprland.lua runs Hyprland's example config and the theme
  install -Dm644 "$startdir"/skel/hyprland.lua -t "$pkgdir/etc/skel/.config/hypr/"
}
